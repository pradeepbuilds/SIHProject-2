# KrishiMitra Backend Environment Configuration
# Copy this file to .env for local development

# Database URL (Used by PostgreSQL/PostGIS in Docker or hosted PostgreSQL like Neon/Supabase)
# If running purely in parquet-backed multi-region mode, the service loads from ml/data/
DATABASE_URL=postgresql://app:app@localhost:5432/weatherdb

# API Key required for authenticated on-demand point queries (POST /prediction)
ADMIN_API_KEY=dev-admin-key-krishimitra

# Data providers (synthetic / imd_bharatfs / gee_copernicus)
FORECAST_PROVIDER=synthetic
FEATURE_PROVIDER=synthetic
OBSERVATION_PROVIDER=synthetic

# Service Port (Default 8000; Render dynamically assigns $PORT)
PORT=8000
